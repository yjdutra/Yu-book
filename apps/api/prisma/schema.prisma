// Yu-book — modelo de dados
//
// Princípio: UMA entidade `Note` com um campo `kind`. Aula, projeto, trilha e
// trabalho são tipos de nota, não tabelas diferentes. Só ganham tabela própria
// as entidades com campos e comportamento realmente distintos.

generator client {
  provider = "prisma-client-js"
}

// As extensões (unaccent, pg_trgm) e a busca full-text são criadas por SQL
// na migration inicial — não vale ligar um preview feature do Prisma por isso.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NoteKind {
  aula
  projeto
  trilha
  trabalho
  livre
}

enum CompanyStatus {
  interesse
  aplicado
  entrevista
  descartada
}

enum CardPriority {
  baixa
  media
  alta
}

/// Favorito dura; "depois" existe para ser consumido e apagado. A diferença é
/// de intenção, não de estrutura — por isso é um campo, não outra tabela.
enum LinkKind {
  favorito
  depois
}

/// Tarefas de IA que consomem modelo. `chat` entra junto porque acrescentar
/// valor a enum do Postgres é migration à parte.
/// `rotina` (Etapa E) só existe para o registro de uso: rotina não tem modelo
/// padrão próprio — cada passo usa o do agente, ou o da tarefa `chat`. Por
/// isso não vira coluna em `/ajustes` (`TAREFAS_COM_MODELO` em shared).
enum AiTask {
  formatar
  chat
  rotina
}

/// Quem falou numa mensagem do chat. `tool` é o resultado que o Yu-book
/// devolveu ao modelo no meio do laço — fica gravado porque o histórico é o que
/// o provedor recebe de volta na mensagem seguinte: sem ele, o modelo veria a
/// própria decisão de chamar a ferramenta sem nunca ver a resposta.
enum AiMessageRole {
  user
  assistant
  tool
}

/// Por qual superfície um conteúdo gerado por IA entrou no acervo (Etapa C da
/// frente de IA). `rotina` entrou na Etapa E; o agente não é via — é quem
/// escreveu, e mora em `aiAgentName`.
enum AiVia {
  chat
  mcp
  rotina
}

/// De onde veio o custo registrado. `desconhecido` é o degrau perigoso: grava
/// zero, não move o teto, e por isso precisa ser contado e mostrado na tela.
enum AiCostSource {
  provedor
  estimado
  desconhecido
}

/// As seis cores de agente (Etapa D da frente de IA). Tons fixos, mapeados para
/// tokens do tema no front — cor livre em hex não passaria pelos dois temas.
/// Espelha `AGENT_COLORS` de `packages/shared/src/agentes.ts`.
enum AiAgentColor {
  violeta
  azul
  verde
  ambar
  rosa
  cinza
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspaces    Workspace[]
  notes         Note[]
  tags          Tag[]
  boards        Board[]
  companies     Company[]
  events        Event[]
  links         Link[]
  refreshTokens RefreshToken[]

  aiPreference    AiPreference?
  aiFavorites     AiModelFavorite[]
  aiTaskModels    AiTaskModel[]
  aiUsages        AiUsage[]
  aiConversations AiConversation[]
  aiAgents        AiAgent[]
  aiRoutines      AiRoutine[]
  aiRoutineRuns   AiRoutineRun[]

  @@map("user")
}

/// Sessão de refresh. Guardamos o hash do token, nunca o token — vazamento do
/// banco não vira sessão válida. Rotação: cada uso revoga o anterior.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// Agrupador que atravessa notas, boards, eventos e empresas (Coders, Trabalho…).
/// Não é multi-tenancy: é uma coluna e um filtro.
model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  color     String   @default("#6366f1")
  icon      String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]
  boards    Board[]
  companies Company[]
  events    Event[]

  @@unique([userId, name])
  @@index([userId, position])
  @@map("workspace")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  kind        NoteKind  @default(livre)
  title       String
  contentMd   String    @default("") @map("content_md")
  /// Campos livres por tipo (módulo, aula, instrutor, link da gravação…).
  /// Evita uma migration a cada campo novo específico de um tipo.
  meta        Json      @default("{}")
  sourceUrl   String?   @map("source_url")
  occurredAt  DateTime? @map("occurred_at")
  isFavorite  Boolean   @default(false) @map("is_favorite")
  /// Lixeira: nota excluída some de listagem, busca, autocomplete e backlinks.
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// A marca de conteúdo gerado (Etapa C da frente de IA). `aiGeneratedAt` não
  /// nulo **é** a marca; os demais a qualificam. Gravada só pelo servidor, na
  /// criação, e nunca apagada: editar à mão preenche `aiRevisedAt` e mantém a
  /// origem.
  aiGeneratedAt    DateTime? @map("ai_generated_at")
  aiVia            AiVia?    @map("ai_via")
  /// No chat, o modelo que respondeu; no MCP, o nome do cliente.
  aiAuthor         String?   @map("ai_author")
  aiConversationId String?   @map("ai_conversation_id") @db.Uuid
  /// Última edição humana de título ou corpo depois de gerado.
  aiRevisedAt      DateTime? @map("ai_revised_at")
  /// O agente que escreveu (Etapa D), gravado na criação. Texto e não chave
  /// estrangeira: excluir o agente não pode apagar quem escreveu.
  aiAgentName      String?   @map("ai_agent_name")
  /// A execução de rotina que criou (Etapa E). `SetNull`: o histórico de
  /// execuções pode ser podado sem apagar a marca. O nome da rotina vai como
  /// texto pelo mesmo motivo de `aiAgentName`.
  aiRunId          String?   @map("ai_run_id") @db.Uuid
  aiRoutineName    String?   @map("ai_routine_name")

  /// Mantida por trigger (ver migration). Consultada via SQL cru.
  searchVector Unsupported("tsvector")? @map("search_vector")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  tags      NoteTag[]
  linksOut  NoteLink[] @relation("linksOut")
  linksIn   NoteLink[] @relation("linksIn")
  cards     Card[]
  events    Event[]
  aiUsages  AiUsage[]
  aiAttachments AiAttachment[]
  aiConversation AiConversation? @relation("NotasGeradas", fields: [aiConversationId], references: [id], onDelete: SetNull)
  aiRun          AiRoutineRun?   @relation("NotasDaRotina", fields: [aiRunId], references: [id], onDelete: SetNull)
  aiAgentBases  AiAgentBaseNote[]
  runsComoSaida AiRoutineRun[]    @relation("NotaDaExecucao")

  @@index([userId, kind])
  @@index([userId, deletedAt, updatedAt(sort: Desc)])
  /// O filtro "Geradas por IA" da lista (Etapa C). Parcial seria menor, mas
  /// índice parcial não se declara aqui, e o que só vive no SQL o Prisma tenta
  /// derrubar na migration seguinte.
  @@index([userId, aiGeneratedAt])
  @@index([workspaceId])
  // Declarados aqui (e não só no SQL) para o Prisma não tentar derrubá-los
  // a cada migration nova.
  @@index([searchVector], map: "note_search_vector_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "note_title_trgm_idx", type: Gin)
  @@map("note")
}

model Tag {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  name   String
  color  String @default("#94a3b8")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTag[]

  @@unique([userId, name])
  @@map("tag")
}

model NoteTag {
  noteId String @map("note_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tag")
}

/// Links wiki `[[titulo]]` resolvidos — alimenta a seção "referenciada por".
model NoteLink {
  fromNoteId String @map("from_note_id") @db.Uuid
  toNoteId   String @map("to_note_id") @db.Uuid

  from Note @relation("linksOut", fields: [fromNoteId], references: [id], onDelete: Cascade)
  to   Note @relation("linksIn", fields: [toNoteId], references: [id], onDelete: Cascade)

  @@id([fromNoteId, toNoteId])
  @@index([toNoteId])
  @@map("note_link")
}

model Board {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns       BoardColumn[]
  aiAttachments AiAttachment[]

  @@unique([workspaceId, name])
  @@index([userId, workspaceId])
  @@map("board")
}

model BoardColumn {
  id       String @id @default(uuid()) @db.Uuid
  boardId  String @map("board_id") @db.Uuid
  name     String
  position Int    @default(0)
  wipLimit Int?   @map("wip_limit")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@unique([boardId, name])
  @@index([boardId, position])
  @@map("board_column")
}

model Card {
  id            String       @id @default(uuid()) @db.Uuid
  columnId      String       @map("column_id") @db.Uuid
  title         String
  descriptionMd String       @default("") @map("description_md")
  position      Int          @default(0)
  dueDate       DateTime?    @map("due_date")
  priority      CardPriority @default(media)
  /// [{ "text": "...", "done": false }]
  checklist     Json         @default("[]")
  /// Etiquetas livres do card (RF-01). Texto na própria linha, sem tabela: tag
  /// de card não tem cor, não é renomeada e não existe fora do card — morre
  /// com ele. A tag de NOTA é outra coisa, e tem tabela (`tag`) por isso.
  tags          String[]     @default([])
  noteId        String?      @map("note_id") @db.Uuid
  archived      Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  /// A marca de conteúdo gerado (Etapa C da frente de IA). `aiGeneratedAt` não
  /// nulo **é** a marca; os demais a qualificam. Gravada só pelo servidor, na
  /// criação, e nunca apagada: editar à mão preenche `aiRevisedAt` e mantém a
  /// origem.
  aiGeneratedAt    DateTime? @map("ai_generated_at")
  aiVia            AiVia?    @map("ai_via")
  /// No chat, o modelo que respondeu; no MCP, o nome do cliente.
  aiAuthor         String?   @map("ai_author")
  aiConversationId String?   @map("ai_conversation_id") @db.Uuid
  /// Última edição humana de título ou corpo depois de gerado.
  aiRevisedAt      DateTime? @map("ai_revised_at")
  /// O agente que escreveu (Etapa D), gravado na criação. Texto e não chave
  /// estrangeira: excluir o agente não pode apagar quem escreveu.
  aiAgentName      String?   @map("ai_agent_name")
  /// A execução de rotina que criou (Etapa E). `SetNull`: o histórico de
  /// execuções pode ser podado sem apagar a marca. O nome da rotina vai como
  /// texto pelo mesmo motivo de `aiAgentName`.
  aiRunId          String?   @map("ai_run_id") @db.Uuid
  aiRoutineName    String?   @map("ai_routine_name")

  column        BoardColumn    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  note          Note?          @relation(fields: [noteId], references: [id], onDelete: SetNull)
  events        Event[]
  aiAttachments AiAttachment[]
  aiConversation AiConversation? @relation("CardsGerados", fields: [aiConversationId], references: [id], onDelete: SetNull)
  aiRun          AiRoutineRun?   @relation("CardsDaRotina", fields: [aiRunId], references: [id], onDelete: SetNull)
  runsComoIdeia  AiRoutineRun[]  @relation("IdeiaDaExecucao")
  runsComoSaida  AiRoutineRun[]  @relation("SaidaDaExecucao")

  @@index([columnId, position])
  @@index([dueDate])
  @@index([noteId])
  // O índice trigram sem acento de `card.title` (busca da paleta, RF-42) é
  // expressão — vive só no SQL da migration, como o de `note`.
  @@map("card")
}

/// Gaveta de links (Fase 3). Não pertence a workspace: a gaveta é uma só (RN-01).
model Link {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  /// Normalizada antes de gravar — é o que faz a unicidade valer (RN-02).
  url    String
  /// Título da página, ou o domínio quando não deu para ler.
  title  String
  domain String
  kind   LinkKind @default(depois)
  /// Duração em segundos, quando a fonte informa (hoje: vídeo do YouTube).
  durationSeconds Int? @map("duration_seconds")
  /// Ordem manual; só significa algo entre os favoritos (RN-03).
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, url])
  @@index([userId, kind, position])
  @@index([userId, kind, createdAt(sort: Desc)])
  @@map("link")
}

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String?       @map("workspace_id") @db.Uuid
  name        String
  website     String
  sector      String?
  status      CompanyStatus @default(interesse)
  notesMd     String        @default("") @map("notes_md")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("company")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  allDay      Boolean  @default(false) @map("all_day")
  location    String?
  url         String?
  noteId      String?  @map("note_id") @db.Uuid
  cardId      String?  @map("card_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  note      Note?      @relation(fields: [noteId], references: [id], onDelete: SetNull)
  card      Card?      @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@map("event")
}

/// Preferências de IA. Primeira tabela de configuração por usuário do projeto:
/// uma linha por conta, criada só quando a pessoa muda alguma coisa. A leitura
/// devolve os padrões de `packages/shared` sem gravar — um `GET` que escreve é
/// surpresa. De um jeito ou de outro, nunca 404 por falta de configuração.
///
/// Sem `@default` de propósito: o padrão já existe em `packages/shared`
/// (`TETO_DIARIO_PADRAO_MICROS`, `FUSO_PADRAO`) e o service é quem escreve. Um
/// padrão aqui seria uma segunda fonte, e as duas divergiriam sem nada reclamar.
model AiPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  /// Teto do dia em µUSD — milionésimo de dólar. 200000 = US$ 0,20.
  dailyCapMicros Int    @map("daily_cap_micros")
  /// Onde o dia do teto começa. A API roda em UTC na Railway e o operador não:
  /// sem isto o teto zeraria três horas antes da meia-noite, todo dia, calado.
  timezone       String
  /// Deixar o provedor guardar e treinar com o conteúdo enviado. É o que torna
  /// os modelos gratuitos utilizáveis — medido em 2026-09-23: com
  /// `data_collection: "deny"` o roteamento devolve 404 "No endpoints found
  /// matching your data policy"; sem ele, o mesmo modelo responde 200.
  allowTraining  Boolean  @map("allow_training")
  /// Etapa F: até quando o Início já mostrou as execuções de rotina. Por
  /// conta, não por navegador — o operador usa mais de um dispositivo. Nulo é
  /// "nunca", e o Início mostra as das últimas 24 h.
  runsSeenAt     DateTime? @map("runs_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_preference")
}

/// Modelo favoritado, com uma **cópia** do catálogo do provedor.
///
/// Cópia e não referência por duas razões: a estimativa de custo não pode
/// buscar as centenas de modelos do provedor dentro da requisição, e a tela
/// precisa listar favoritos com o provedor fora do ar. `snapshotAt` registra
/// quando a cópia foi tirada — preço de modelo muda.
model AiModelFavorite {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// Slug do provedor (`anthropic/claude-x`). É a chave de negócio, e tem
  /// barra — por isso `POST /ai/favorites` recebe o id no corpo, não no caminho.
  modelId          String   @map("model_id")
  name             String
  contextLength    Int      @map("context_length")
  /// µUSD por milhão de tokens, como `AiModel` do shared. "Gratuito" não é
  /// coluna: é derivado destes dois, para não haver um terceiro lugar decidindo.
  promptMicros     Int      @map("prompt_micros")
  completionMicros Int      @map("completion_micros")
  /// A bandeira de que as etapas seguintes dependem: um modelo que não sabe
  /// chamar ferramenta conversa bem e não consegue consultar o acervo.
  supportsTools    Boolean  @map("supports_tools")
  snapshotAt       DateTime @default(now()) @map("snapshot_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_model_favorite")
}

/// O modelo padrão de cada tarefa. Uma linha por par, sem id próprio — é
/// tabela de associação, como `NoteTag`.
model AiTaskModel {
  userId    String   @map("user_id") @db.Uuid
  task      AiTask
  modelId   String   @map("model_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, task])
  @@map("ai_task_model")
}

/// Uma linha por chamada ao provedor, inclusive as que falharam. É o que
/// alimenta o teto diário e o painel de custo.
model AiUsage {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  task   AiTask
  /// O modelo pedido.
  modelId String @map("model_id")
  /// O que o provedor de fato usou — pode diferir do pedido por roteamento.
  /// Sem isto a estimativa de custo usaria o preço do modelo errado.
  modelUsed    String? @map("model_used")
  /// Id da resposta do provedor. Entra agora porque é o que permite reconciliar
  /// o custo depois sem migration nova; a reconciliação em si é outra entrega.
  generationId String? @map("generation_id")

  promptTokens     Int          @default(0) @map("prompt_tokens")
  completionTokens Int          @default(0) @map("completion_tokens")
  costMicros       Int          @default(0) @map("cost_micros")
  costSource       AiCostSource @map("cost_source")
  durationMs       Int          @map("duration_ms")
  ok               Boolean
  errorCode        String?      @map("error_code")

  /// O dia **do usuário** (AAAA-MM-DD), não o dia UTC, e gravado em vez de
  /// calculado na consulta: a janela do teto tem que ser a mesma que a tela
  /// mostra, e o fuso do processo não é o do operador.
  localDay String  @map("local_day")
  /// `SetNull` como em `Event.noteId`: apagar a nota não apaga o registro de
  /// gasto, ou o teto diário viraria resetável por exclusão de nota.
  noteId   String? @map("note_id") @db.Uuid
  /// Mesma regra, mesmo motivo: uma mensagem do chat custa até cinco chamadas,
  /// e apagar a conversa não pode zerar o que já foi gasto hoje.
  conversationId String? @map("conversation_id") @db.Uuid
  /// A execução de rotina que gastou (Etapa E). Mesma regra: excluir a rotina
  /// ou a execução não devolve ao teto o que já foi gasto hoje.
  runId          String? @map("run_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  note         Note?           @relation(fields: [noteId], references: [id], onDelete: SetNull)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  run          AiRoutineRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, localDay])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_usage")
}

/// Uma conversa do chat interno (Etapa B da frente de IA, RF-23 e RF-24).
///
/// Escopada por usuário como tudo o mais: id de outra conta é indistinguível de
/// inexistente. Excluir a conversa apaga suas mensagens e anexos por cascata, e
/// **não** toca em nota nem em card — o anexo é um ponteiro, não uma posse.
model AiConversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  title  String
  /// O agente da conversa (Etapa D), fixo desde a criação. `SetNull`: excluir
  /// o agente não apaga a conversa, e `agentName` guarda quem respondeu.
  agentId   String? @map("agent_id") @db.Uuid
  agentName String? @map("agent_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    AiAgent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages AiMessage[]
  usages   AiUsage[]
  /// O que esta conversa criou no acervo. `SetNull` do outro lado: apagar a
  /// conversa perde o link "Abrir conversa", nunca a marca.
  notasGeradas Note[] @relation("NotasGeradas")
  cardsGerados Card[] @relation("CardsGerados")

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversation")
}

/// Uma fala da conversa. O histórico inteiro volta ao provedor a cada mensagem,
/// então ele é o dado, não o registro do dado.
model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String

  /// Preenchidos só em `assistant`: RF-25 pede que o painel diga qual modelo
  /// respondeu **cada** mensagem, e a escolha pode mudar entre uma e outra.
  modelId   String? @map("model_id")
  modelUsed String? @map("model_used")

  /// Quem o modelo chamou, quando esta linha é o resultado de uma ferramenta.
  /// O nome fica para o painel poder dizer "consultei o quadro X" sem reabrir
  /// o conteúdo, que é texto formatado para o modelo, não para a tela.
  toolName   String? @map("tool_name")
  /// O `tool_call_id` do provedor. É ele que amarra o resultado ao pedido na
  /// mensagem seguinte; sem ele o provedor recusa o histórico.
  toolCallId String? @map("tool_call_id")
  /// Os pedidos de ferramenta que **esta** mensagem de assistente fez, como o
  /// provedor os devolveu. JSON e não tabela: a forma é do provedor, o Yu-book
  /// só a devolve intacta no turno seguinte, e modelá-la seria inventar um
  /// esquema para um dado que não consultamos por campo.
  toolCalls Json? @map("tool_calls")
  /// O que o turno consultou, gravado na fala que o fecha (RF-20, RN-05).
  ///
  /// Persistido, e não recalculado na leitura: as fontes nascem do resultado
  /// das ferramentas daquele momento, e uma nota que vá para a lixeira depois
  /// não pode apagar do histórico o fato de ela ter sido consultada. JSON pelo
  /// mesmo motivo de `toolCalls` — é uma lista que a tela desenha inteira,
  /// nunca um campo que se consulta.
  sources Json? @map("sources")
  /// O que a resposta criou no acervo (Etapa C), para o chat mostrar e
  /// desfazer. Persistido pelo mesmo motivo de `sources`.
  created Json? @map("created")

  createdAt DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  AiAttachment[]

  @@index([conversationId, createdAt])
  @@map("ai_message")
}

/// O que o usuário anexou pelo `@` ao escrever **aquela** mensagem.
///
/// Pende da mensagem, não da conversa — o PRD modelou o contrário, e a decisão
/// foi revista: preso à conversa, o histórico mente, porque uma mensagem feita
/// antes de anexar a nota apareceria depois como se já a tivesse tido.
///
/// Os três alvos são `SetNull`: apagar a nota anexada não apaga a conversa, do
/// mesmo jeito que o vínculo card ↔ nota já se desfaz sem levar o card junto.
model AiAttachment {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @map("message_id") @db.Uuid
  noteId    String? @map("note_id") @db.Uuid
  cardId    String? @map("card_id") @db.Uuid
  boardId   String? @map("board_id") @db.Uuid
  /// O título no momento do anexo. Sem isto, um anexo cujo alvo foi apagado
  /// vira três nulos e o histórico perde a única coisa que ele dizia.
  title String

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note    Note?     @relation(fields: [noteId], references: [id], onDelete: SetNull)
  card    Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  board   Board?    @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@map("ai_attachment")
}

/// Um agente especialista (Etapa D da frente de IA): instruções, notas-base,
/// fontes vivas, modelo e ferramentas. Tabela própria, não um tipo de nota — a
/// portabilidade vem pela exportação em Markdown.
model AiAgent {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  name           String
  description    String       @default("")
  color          AiAgentColor @default(violeta)
  instructionsMd String       @default("") @map("instructions_md")
  /// Nulo = usa o modelo da tarefa `chat`. Não é chave estrangeira para o
  /// favorito: desfavoritar não pode apagar nem alterar o agente, e a
  /// conferência de que ainda é favorito acontece na hora do uso.
  modelId        String?      @map("model_id")
  /// Nomes de `FERRAMENTAS_DO_CHAT`. Só esta lista concede ferramenta; texto de
  /// instrução, não.
  tools          String[]     @default([])
  /// Até cinco `{ tipo: "coluna", boardId, columnId, limite, detalhe }`. JSON e
  /// não tabela: a posse da coluna é conferida pela cadeia ao gravar e de novo
  /// ao ler, e uma coluna que sumiu vira aviso, não erro de FK.
  liveSources    Json         @default("[]") @map("live_sources")
  /// Etapa G: a primeira chamada de cada mensagem (e de cada passo de rotina)
  /// leva o plugin de busca na web do provedor. Opt-in: cada busca é cobrada.
  webSearch      Boolean      @default(false) @map("web_search")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseNotes     AiAgentBaseNote[]
  conversations AiConversation[]
  routineSteps  AiRoutineStep[]

  @@unique([userId, name])
  @@map("ai_agent")
}

/// Uma nota-base de agente, em ordem. Cascata dos dois lados: é associação,
/// não posse.
model AiAgentBaseNote {
  agentId  String @map("agent_id") @db.Uuid
  noteId   String @map("note_id") @db.Uuid
  position Int

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  note  Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([agentId, noteId])
  @@index([noteId])
  @@map("ai_agent_base_note")
}

/// Status de uma execução de rotina (Etapa E). `interrompida` é a que o
/// processo perdeu — redeploy ou queda —, reconciliada no boot: a execução
/// mora num `Map` em memória, e sem o processo não há quem a termine.
/// `pulada` (Etapa F) é o horário agendado cujo início foi recusado em todas
/// as tentativas até aqui; nasce terminal, sem passos.
enum AiRunStatus {
  em_andamento
  concluida
  falhou
  cancelada
  interrompida
  pulada
}

/// Quem disparou a execução (Etapa F): o "Rodar agora" ou a agenda.
enum AiRunTrigger {
  manual
  agenda
}

enum AiRunStepStatus {
  pendente
  rodando
  concluido
  falhou
  pulado
}

/// "reescreve" substitui o rascunho; "revisa" acumula observações e não mexe
/// nele.
enum AiStepMode {
  reescreve
  revisa
}

/// O que o código — e não o modelo — faz com a ideia depois de uma execução
/// bem-sucedida.
enum AiConsumeAction {
  mover
  arquivar
  manter
}

/// De onde sai o título da saída. `fixo` é o texto de `outputTitleText`
/// (emenda da Etapa E); `ideia` não vale com entrada por pedido.
enum AiOutputTitle {
  ideia
  primeira_linha
  fixo
}

/// De onde a rotina parte (emenda da Etapa E): a próxima ideia de uma coluna,
/// ou um pedido escrito na própria rotina, o mesmo a cada execução.
enum AiInputKind {
  coluna
  pedido
}

/// O que a rotina deixa no fim: um card numa coluna, ou uma nota nova.
enum AiOutputKind {
  card
  nota
}

/// Uma rotina (Etapa E da frente de IA): agentes encadeados numa sequência
/// fixa, disparada à mão. Lê a próxima ideia de uma coluna, passa pelos
/// passos e grava um card na coluna de saída.
///
/// As colunas não são chave estrangeira, como a fonte viva do agente: `card`
/// e `board_column` não têm `user_id`, a posse é conferida pela cadeia ao
/// gravar e de novo ao rodar, e coluna que sumiu deixa a rotina **inválida**
/// com o motivo — não apaga a rotina nem vira erro de FK.
model AiRoutine {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  name            String
  description     String          @default("")
  /// A coerência entre o tipo e os campos é do Zod (`problemasDeForma`) e do
  /// service, que grava nulo no que o tipo não usa: `coluna` usa quadro e
  /// coluna, `pedido` usa `inputPrompt`.
  inputKind       AiInputKind     @default(coluna) @map("input_kind")
  inputBoardId    String?         @map("input_board_id") @db.Uuid
  inputColumnId   String?         @map("input_column_id") @db.Uuid
  inputPrompt     String?         @map("input_prompt")
  /// `card` usa `outputColumnId`; `nota`, `outputWorkspaceId` (nulo é "sem
  /// workspace"). Nenhum dos dois é chave estrangeira: coluna e workspace que
  /// somem viram `problems`, não saída desviada em silêncio.
  outputKind        AiOutputKind  @default(card) @map("output_kind")
  outputColumnId    String?       @map("output_column_id") @db.Uuid
  outputWorkspaceId String?       @map("output_workspace_id") @db.Uuid
  outputTitle     AiOutputTitle   @default(ideia) @map("output_title")
  /// Só com `outputTitle = fixo`.
  outputTitleText String?         @map("output_title_text")
  includeNotes    Boolean         @default(true) @map("include_notes")
  consumeAction   AiConsumeAction @map("consume_action")
  /// Só com `mover`, e do mesmo quadro da entrada: `moverCard` não atravessa
  /// quadro (RN-04 da Fase 2).
  consumeColumnId String?         @map("consume_column_id") @db.Uuid
  /// Teto por execução, em µUSD. Soma-se ao diário: os dois cortam.
  runCapMicros    Int             @map("run_cap_micros")
  /// A agenda (Etapa F): dias da semana 0–6 (0 = domingo) e horários `HH:MM`
  /// no fuso do dono, `ai_preference.timezone`. A forma é do Zod
  /// (`scheduleSchema`); ligada exige ao menos um dia e um horário.
  scheduleDays    Int[]           @default([]) @map("schedule_days")
  scheduleTimes   String[]        @default([]) @map("schedule_times")
  scheduleActive  Boolean         @default(false) @map("schedule_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  /// Última gravação pelo operador. O agendador não atende horário anterior a
  /// ele (Etapa F); o motor de execução nunca escreve nesta tabela.
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps AiRoutineStep[]
  runs  AiRoutineRun[]

  @@unique([userId, name])
  @@map("ai_routine")
}

/// Um passo da rotina, em ordem.
model AiRoutineStep {
  id          String     @id @default(uuid()) @db.Uuid
  routineId   String     @map("routine_id") @db.Uuid
  position    Int
  /// `SetNull`: excluir o agente não apaga o passo. A rotina fica inválida,
  /// dizendo qual agente sumiu, e recusa rodar até alguém trocar.
  agentId     String?    @map("agent_id") @db.Uuid
  agentName   String     @map("agent_name")
  mode        AiStepMode
  instruction String     @default("")

  routine AiRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  agent   AiAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([routineId, position])
  @@index([agentId])
  @@map("ai_routine_step")
}

/// Uma execução. Guarda o nome da rotina e o título da ideia como texto: o
/// histórico sobrevive à exclusão da rotina e do card.
model AiRoutineRun {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  routineId    String?     @map("routine_id") @db.Uuid
  routineName  String      @map("routine_name")
  status       AiRunStatus @default(em_andamento)
  /// Copiado da rotina no início: ela pode mudar de tipo depois, e
  /// `inputCardId` nulo (SetNull) não distingue um pedido de uma ideia excluída.
  inputKind    AiInputKind @default(coluna) @map("input_kind")
  inputCardId  String?     @map("input_card_id") @db.Uuid
  /// O título da ideia, ou a primeira linha do pedido.
  inputTitle   String?     @map("input_title")
  outputCardId String?     @map("output_card_id") @db.Uuid
  outputNoteId String?     @map("output_note_id") @db.Uuid
  runCapMicros Int         @map("run_cap_micros")
  costMicros   Int         @default(0) @map("cost_micros")
  errorCode    String?     @map("error_code")
  errorMessage String?     @map("error_message")
  startedAt    DateTime    @default(now()) @map("started_at")
  endedAt      DateTime?   @map("ended_at")
  /// O pulso do processo que executa, renovado enquanto ela roda. Numa janela
  /// de deploy duas instâncias convivem, e o `Map` de uma não enxerga o da
  /// outra: é este carimbo, e não "estar no meu `Map`", que diz se a execução
  /// tem dono. Só a de pulso vencido é reconciliada.
  heartbeatAt       DateTime  @default(now()) @map("heartbeat_at")
  /// Pedido de cancelamento vindo de qualquer instância. Quem executa o confere
  /// no pulso e antes de cada passo e volta, e grava ele mesmo `cancelada`.
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  /// Etapa F. As linhas de antes são manuais pelo padrão.
  trigger           AiRunTrigger @default(manual)
  /// Só com `agenda`: o instante UTC do horário, e quantas tentativas ele teve.
  /// O único `(routineId, scheduledFor)` é o que faz cada horário rodar no
  /// máximo uma vez com duas instâncias da API (INV-60); nulos não colidem,
  /// então a execução manual fica fora dele.
  scheduledFor      DateTime?    @map("scheduled_for")
  attempts          Int?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine    AiRoutine?         @relation(fields: [routineId], references: [id], onDelete: SetNull)
  inputCard  Card?              @relation("IdeiaDaExecucao", fields: [inputCardId], references: [id], onDelete: SetNull)
  outputCard Card?              @relation("SaidaDaExecucao", fields: [outputCardId], references: [id], onDelete: SetNull)
  outputNote Note?              @relation("NotaDaExecucao", fields: [outputNoteId], references: [id], onDelete: SetNull)
  steps      AiRoutineRunStep[]
  usages     AiUsage[]
  notas      Note[]             @relation("NotasDaRotina")
  cards      Card[]             @relation("CardsDaRotina")

  // RN-19 tem ainda um índice único parcial, `ai_routine_run_uma_em_andamento_idx`
  // — `(user_id) WHERE status = 'em_andamento'`, na migration
  // `20260924233000_ia_etapa_e_uma_execucao`. Índice com `WHERE` não se declara
  // aqui; o Prisma não o introspecta nem tenta derrubá-lo (conferido com
  // `prisma migrate diff`: vazio). Gravam `em_andamento` a criação e, desde a
  // Etapa F, a conversão de uma `pulada` em execução (`iniciar`, tentativa
  // seguinte de um horário) — as duas traduzem o `P2002` dele.
  @@unique([routineId, scheduledFor])
  @@index([userId, status])
  @@index([routineId, startedAt(sort: Desc)])
  @@index([inputCardId])
  @@map("ai_routine_run")
}

/// Um passo executado. Cópia do passo da rotina no momento da execução: editar
/// a rotina depois não reescreve o histórico.
model AiRoutineRunStep {
  id               String          @id @default(uuid()) @db.Uuid
  runId            String          @map("run_id") @db.Uuid
  position         Int
  agentName        String          @map("agent_name")
  mode             AiStepMode
  instruction      String          @default("")
  modelId          String?         @map("model_id")
  modelUsed        String?         @map("model_used")
  status           AiRunStepStatus @default(pendente)
  text             String          @default("")
  promptTokens     Int             @default(0) @map("prompt_tokens")
  completionTokens Int             @default(0) @map("completion_tokens")
  costMicros       Int             @default(0) @map("cost_micros")
  durationMs       Int             @default(0) @map("duration_ms")
  errorCode        String?         @map("error_code")
  startedAt        DateTime?       @map("started_at")
  endedAt          DateTime?       @map("ended_at")
  /// Etapa G: o que o passo consultou — acervo e web, na forma de `ChatSource`.
  /// Nulo nas execuções anteriores a ela e no passo que não chegou ao fim.
  sources          Json?

  run AiRoutineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@map("ai_routine_run_step")
}

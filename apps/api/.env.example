# Copie para .env e ajuste. Nunca versione o .env.

NODE_ENV=development
PORT=3333

# Local (container postgres já rodando na 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yubook?schema=public"

# Gere um novo: openssl rand -base64 48
JWT_SECRET="troque-isto-por-48-bytes-aleatorios-de-verdade-ok"

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Origens do front, separadas por vírgula. Em produção, sem curinga.
CORS_ORIGIN="http://localhost:5173"

# Deixe true só até criar sua conta. Depois: false.
ALLOW_SIGNUP=true

# Em produção com API e front em domínios diferentes: none
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.seudominio.com

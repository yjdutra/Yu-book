# Copie para .env e ajuste. Nunca versione o .env.

NODE_ENV=development
PORT=3333

# Local (container postgres já rodando na 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yubook?schema=public"

# Gere um novo: openssl rand -base64 48
JWT_SECRET="troque-isto-por-48-bytes-aleatorios-de-verdade-ok"

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Origens do front, separadas por vírgula. Em produção, sem curinga.
CORS_ORIGIN="http://localhost:5173"

# Deixe true só até criar sua conta. Depois: false.
ALLOW_SIGNUP=true

# Em produção com API e front em domínios diferentes: none
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.seudominio.com

# --- IA (Fase 5) -------------------------------------------------------------
# Opcional. Sem ela a API sobe igual e só as funções de IA ficam indisponíveis.
# OPENROUTER_API_KEY="sk-or-v1-..."
# Só mude para apontar a suíte para um dublê local. Produção usa o padrão.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Atribuição no painel do OpenRouter. Opcional.
# OPENROUTER_APP_URL="https://yu-book.up.railway.app"
# Opcional. Management key (openrouter.ai/settings/management-keys): saldo,
# histórico e métricas em /ajustes/openrouter. Não faz inferência e, no
# provedor, cria e apaga chaves — a API só a usa para ler, em caminhos fixos.
# OPENROUTER_MANAGEMENT_KEY="sk-or-v1-..."

# --- Anexos de card (frente de cards, Parte 2) ------------------------------
# Opcionais. Sem as quatro primeiras a API sobe igual e só os anexos ficam
# indisponíveis. Na Railway, crie um Storage Bucket no projeto e referencie as
# variáveis dele no serviço da API: S3_ENDPOINT=${{Bucket.ENDPOINT}},
# S3_BUCKET=${{Bucket.BUCKET}}, S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}},
# S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}} (o nome do serviço do
# bucket pode ser outro). Qualquer S3 compatível serve — R2, por exemplo.
# S3_ENDPOINT="https://<o ENDPOINT que o bucket mostra>"
# S3_BUCKET="..."
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="auto"
# Só para o dublê local da suíte: o bucket no caminho, e não no subdomínio.
# S3_PATH_STYLE=false

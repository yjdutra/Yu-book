{
  "name": "@yu-book/api",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:mcp": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/yubook_mcp?schema=public\" PORT=3334 tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/yubook_mcp?schema=public\" tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.0",
    "@yu-book/shared": "workspace:*",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}

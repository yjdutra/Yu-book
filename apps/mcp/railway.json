{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @yu-book/shared build && pnpm --filter @yu-book/mcp build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production MCP_TRANSPORTE=http pnpm --filter @yu-book/mcp start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

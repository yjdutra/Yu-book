{
  "name": "yu-book",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @yu-book/shared build && pnpm --filter @yu-book/api build && pnpm --filter @yu-book/web build && pnpm --filter @yu-book/mcp build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @yu-book/api db:migrate",
    "db:studio": "pnpm --filter @yu-book/api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.9"
}
